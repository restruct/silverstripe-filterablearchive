{
  "name": "restruct/silverstripe-filterablearchive",
  "description": "Turn a holder page's children (news, blog posts) into an archive visitors filter by date, category or tag, with pagination and related items. For Silverstripe 5 and 6.",
  "type": "silverstripe-vendormodule",
  "license": "BSD-3-Clause",
  "keywords": [
    "silverstripe",
    "silverstripe-module",
    "silverstripe-cms",
    "archive",
    "blog",
    "categories",
    "filter",
    "news",
    "pagination",
    "tags"
  ],
  "authors": [ { "name": "Restruct", "email": "dev@restruct.nl", "homepage": "https://restruct.nl" } ],
  "require": {
    "php": "^8.1",
    "silverstripe/vendor-plugin": "^2 || ^3",
    "silverstripe/cms": "^5 || ^6",
    "silverstripe/tagfield": "^3 || ^4",
    "symbiote/silverstripe-gridfieldextensions": "^4 || ^5"
  },
  "require-dev": {
    "silverstripe/recipe-testing": "^3 || ^4"
  },
  "extra": {
    "installer-name": "filterablearchive"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/restruct"
    }
  ]
}
